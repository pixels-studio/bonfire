{
  "name": "bonfire",
  "version": "0.1.0",
  "description": "Local-first workspace for coding agent CLIs",
  "main": "dist/main/index.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build && node scripts/build-electron.mjs",
    "prestart": "npm run build",
    "start": "electron .",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.electron.json",
    "rebuild": "electron-rebuild -f -w node-pty",
    "postinstall": "electron-rebuild -f -w node-pty",
    "test": "node scripts/test.mjs",
    "smoke": "node scripts/test.mjs",
    "format": "prettier --write src electron shared scripts *.json *.ts *.js README.md"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.287",
    "@lucide/svelte": "^1.47.0",
    "@openai/codex-sdk": "^0.155.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "bits-ui": "^2.19.2",
    "chokidar": "^5.0.0",
    "clsx": "^2.1.1",
    "node-pty": "^1.1.0",
    "svelte": "^5.57.0",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@internationalized/date": "^3.12.4",
    "@types/node": "^26.6.1",
    "electron": "^44.4.3",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.8",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte-check": "^4.7.6",
    "typescript": "~6.0.3"
  },
  "private": true
}
