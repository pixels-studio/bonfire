{
  "name": "bonfire",
  "version": "0.1.0",
  "description": "Local-first workspace for coding agent CLIs",
  "main": "dist/main/index.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:onboarding": "node scripts/dev.mjs --onboarding",
    "build": "vite build && node scripts/build-electron.mjs",
    "package": "node scripts/package-mac.mjs",
    "package:win": "node scripts/package-win.mjs",
    "prestart": "npm run build",
    "start": "electron .",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.electron.json",
    "rebuild": "electron-rebuild -f -w node-pty",
    "postinstall": "node scripts/postinstall.mjs",
    "test": "node scripts/test.mjs",
    "smoke": "node scripts/test.mjs",
    "format": "prettier --write src electron shared scripts *.json *.ts *.js README.md",
    "test:unit": "node scripts/unit.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.287",
    "@fontsource-variable/inter": "^5.3.0",
    "@openai/codex": "0.155.1",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@internationalized/date": "^3.12.4",
    "@lucide/svelte": "^1.47.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-bold": "^3.31.4",
    "@tiptap/extension-italic": "^3.31.4",
    "@tiptap/extensions": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^26.6.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "bits-ui": "^2.19.2",
    "clsx": "^2.1.1",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "dompurify": "^3.4.16",
    "electron": "^44.4.3",
    "esbuild": "^0.28.2",
    "layerchart": "^2.5.1",
    "marked": "^18.0.14",
    "prettier": "^3.9.8",
    "prettier-plugin-svelte": "^4.1.1",
    "rcedit": "^5.0.2",
    "shiki": "^4.5.0",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.0",
    "zod": "^4.6.5"
  },
  "private": true
}
